/* Copied (modified) from https://github.com/caksoylar/zmk-config */
#define COMBO(NAME, BINDINGS, KEYPOS, LAYERS, TERM, QUICKTAP) \
  combo_##NAME { \
    timeout-ms = <TERM>; \
    bindings = <BINDINGS>; \
    key-positions = <KEYPOS>; \
    layers = <LAYERS>; \
    require-prior-idle-ms = <QUICKTAP>; \
  };

/ {
  combos {
    compatible = "zmk,combos";
    /*
         LEFT                    RIGHT              JOYSTICK        ENCODER
     0  1  2  3  4  5       7  8  9 10 11 12           6
    13 14 15 16 17 18      20 21 22 23 24 25       19 32 45
    26 27 28 29 30 31      33 34 35 36 37 38          58
    39 40 41 42 43 44      46 47 48 49 50 51
       53 54 55 56 57      59 60 61 62 63                          52
    */

    /* Function Keys */
    COMBO(f11      , &kp F11      , 0 1    , BASE     , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    COMBO(f12      , &kp F12      , 1 2    , BASE     , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)

    /* System */
    COMBO(rst_boot_l , &rst_boot  ,  0 13 26 39 , NAV , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    COMBO(rst_boot_r , &rst_boot  , 12 25 38 51 , NAV , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)

    /* Symbols */
    // Left high
    COMBO(grave    , &kp GRAVE    , 0 13   , BASE     , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    COMBO(excl     , &kp EXCL     , 1 14   , BASE     , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    COMBO(at       , &kp AT       , 2 15   , BASE     , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    COMBO(hash     , &kp HASH     , 3 16   , BASE     , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    COMBO(dollar   , &kp DOLLAR   , 4 17   , BASE     , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    COMBO(percent  , &kp PERCENT  , 5 18   , BASE     , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    // Right high
    COMBO(caret    , &kp CARET    , 7 20   , BASE     , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    COMBO(ampersand, &kp AMPERSAND, 8 21   , BASE     , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    COMBO(star     , &kp STAR     , 9 22   , BASE     , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    COMBO(lpar     , &kp LPAR     , 10 23  , BASE     , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    COMBO(rpar     , &kp RPAR     , 11 24  , BASE     , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    // Right
    //COMBO(minus    , &kp MINUS    , 7 19   , BASE NAV, COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    //COMBO(equal    , &kp EQUAL    , 8 20   , BASE NAV, COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    //COMBO(slash    , &kp SLASH    , 9 21   , BASE NAV, COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    COMBO(pgup     , &kp PG_UP    , 20 33  , BASE NAV, COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    COMBO(pgdn     , &kp PG_DN    , 33 46  , BASE NAV, COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    //COMBO(lbkt     , &kp LBKT     , 19 31  , BASE NAV, COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    //COMBO(rbkt     , &kp RBKT     , 20 32  , BASE NAV, COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    //COMBO(backslash, &kp BACKSLASH, 21 33  , BASE NAV, COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    /* Bluetooth */
    COMBO(bt_clear , &bt BT_CLR   , 1 2 3 4, NAV   , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    COMBO(bt_sel_0 , &bt BT_SEL 0 , 1 14   , NAV   , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    COMBO(bt_sel_1 , &bt BT_SEL 1 , 2 15   , NAV   , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    COMBO(bt_sel_2 , &bt BT_SEL 2 , 3 16   , NAV   , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    COMBO(bt_sel_3 , &bt BT_SEL 3 , 4 17   , NAV   , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    COMBO(bt_sel_4 , &bt BT_SEL 4 , 5 18   , NAV   , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    COMBO(bt_usb   , &out OUT_TOG , 3 4 5  , NAV   , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    /* Media */
    //COMBO(play     , &kp C_PP     , 6 7    , BASE NAV, COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    /* RGB */
    COMBO(rgb_tog , &rgb_ug RGB_TOG , 31 44, NAV   , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    COMBO(rgb_bri_up , &rgb_ug RGB_BRI , 30 43, NAV   , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
    COMBO(rgb_bri_down , &rgb_ug RGB_BRD , 29 42, NAV   , COMBO_TERM_DEFAULT, COMBO_QUICK_TAP_MS)
  };
};
